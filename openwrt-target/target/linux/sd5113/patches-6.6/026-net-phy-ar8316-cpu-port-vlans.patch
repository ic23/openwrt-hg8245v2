+/* Each access port has only the CPU as a forwarding destination. The
+ * AR8316 shares learned MACs across VIDs, so a copy flooded by the host
+ * bridge would move the original sender to the CPU port.
+ */
+static bool
+ar8316_has_cpu_port_vlans(struct ar8xxx_priv *priv, const u8 *portmask)
+{
+	int i;
+
+	if (!chip_is_ar8316(priv) || priv->init || !priv->vlan ||
+	    !(priv->vlan_tagged & BIT(AR8216_PORT_CPU)) ||
+	    hweight8(portmask[AR8216_PORT_CPU]) < 2)
+		return false;
+
+	for (i = 0; i < priv->dev.ports; i++)
+		if (i != AR8216_PORT_CPU && (portmask[i] & ~BIT(AR8216_PORT_CPU)))
+			return false;
+
+	return true;
+}
