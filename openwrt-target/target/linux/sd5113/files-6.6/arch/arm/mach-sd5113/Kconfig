# SPDX-License-Identifier: GPL-2.0-only
#
# HiSilicon SD5113 (Huawei HG8245 GPON ONT), ARM1176JZF-S. Reverse-engineered,
# not validated on silicon - see STAGE3_CHANGES.md / UNRESOLVED.md in the
# project archive for what is confirmed. Hooked in by
# patches-6.6/001 (arch/arm/Kconfig `source`) and 002 (machine-y).
#
# NOTE (v6K): ARCH_MULTI_V6 selects CPU_V6K. The vendor 2.6.21 kernel was built
# without CPU_32v6K and never emits ldrexb/strexb/...; that is a toolchain/config
# choice, not evidence about the silicon: the MIDR recorded for this SoC family
# (0x410fb767) is ARM1176JZF-S r0p7, the same core as the Raspberry Pi 1, which
# mainline runs with CPU_V6K. CPU_V6 is selected too, so the generic code stays
# on the v6-safe cmpxchg path. Standing the platform up without ARCH_MULTI_V6
# was tried and REJECTED: it falls back to ARCH_MULTI_V5 -> CPU_ARM926T.

config ARCH_SD5113
	bool "HiSilicon SD5113 (Huawei HG8245 ONT)"
	depends on ARCH_MULTI_V6
	select ARM_AMBA
	select ARM_TIMER_SP804
	select CPU_V6
	select GENERIC_CLOCKEVENTS
	select GPIOLIB
	select GPIO_SD5113
	select MDIO_SD5113
	select MFD_SYSCON
	select PHYLIB
	help
	  Support for the HiSilicon SD5113 SoC (ARM1176JZF-S, ARMv6) used in
	  the Huawei HG8245. Selects the timer, interrupt controller, GPIO and
	  MDIO drivers written for it; the CPU-port MAC (NET_SD5113_ETH) and the
	  PCI host (PCI_SD5113) are enabled separately in their own menus.

config SD5113_BOOT_DEBUG
	bool "SD5113 early UART diagnostics"
	depends on ARCH_SD5113
	select DEBUG_KERNEL
	select DEBUG_LL
	help
	  Enable board-specific low-level output for RAM-boot bring-up.
