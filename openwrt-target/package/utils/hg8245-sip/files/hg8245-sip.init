#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
	. /lib/functions/network.sh
	local enabled port peer ip
	config_load hg8245
	config_get_bool enabled sip enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get port sip port tel1
	config_get peer sip peer
	case "$port" in tel1|tel2) ;; *) return 1;; esac
	network_get_ipaddr ip lan || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/hg8245-sip "$port" "$ip"
	[ -z "$peer" ] || procd_append_param command "$peer"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger hg8245
	procd_add_interface_trigger "interface.*" lan /etc/init.d/hg8245-sip restart
}
